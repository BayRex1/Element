# Element plugin sample (API sketch)
# Target API: Element Plugin API 1
# This file is a portable example specification, not executable until the .plugin script runtime is wired into the app.

__id__ = "halloween_theme"
__name__ = "Halloween Theme"
__description__ = "Halloween accents for Element"
__author__ = "@you"
__version__ = "1.0.0"
__api_version__ = 1

def on_load(api):
    # Planned public hooks: api.on_before_publish(...), api.set_color(...)
    api.set_color("accent", "#FF7A00")
    api.set_color("surface", "#1E1226")

    def before_publish(event):
        if event.text.strip() and not event.text.startswith("/"):
            event.text = event.text + " 🎃"

    api.on_before_publish(before_publish)

def on_unload(api):
    api.set_color("accent", None)
    api.set_color("surface", None)
